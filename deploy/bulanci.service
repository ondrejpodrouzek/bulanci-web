[Unit]
Description=Bulanci web
After=network.target

[Service]
User=bulanci
WorkingDirectory=/opt/bulanci-web
Environment=BULANCI_HOST=127.0.0.1 PORT=4173
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
